# Copy to .env in the project root before running docker compose
POSTGRES_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
WEB_PORT=3000

# First account (created automatically on first boot when the database is empty).
# Log in with these credentials, then create your partner's account in Settings.
SEED_EMAIL=you@example.com
SEED_PASSWORD=pick-a-password-min-8-chars
SEED_NAME=YourName

# Optional — only for the AI budget suggestion feature (any OpenAI-compatible endpoint)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
